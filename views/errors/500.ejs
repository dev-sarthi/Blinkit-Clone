<section class="section error-page">
  <div class="container" style="text-align:center; padding: 80px 20px;">
    <h1 style="font-size: 5rem; margin-bottom: 0;">500</h1>
    <p style="font-size: 1.25rem; color: var(--text-muted); margin-bottom: 16px;">Something went wrong on our end.</p>
    <% if (typeof message !== 'undefined' && message) { %>
      <p style="color: var(--text-muted); margin-bottom: 24px;"><%= message %></p>
    <% } %>
    <a href="/" class="btn btn-primary">Go Home</a>
  </div>
</section>
