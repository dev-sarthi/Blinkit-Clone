<section class="section">
  <div class="container">
    <h1 class="section-title"><%= product ? 'Edit Product' : 'Add Product' %></h1>

    <div class="profile-card">
      <form action="/admin/products/<%= product ? 'edit/' + product._id : 'add' %>"
            method="POST" enctype="multipart/form-data" class="auth-form" id="productForm">

        <div class="form-group">
          <label for="name">Product Name</label>
          <input type="text" name="name" id="name" value="<%= product ? product.name : '' %>" required>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea name="description" id="description" rows="3"><%= product ? product.description : '' %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price">Price (₹)</label>
            <input type="number" name="price" id="price" step="0.01" value="<%= product ? product.price : '' %>" required>
          </div>
          <div class="form-group">
            <label for="discountPrice">Discount Price (₹)</label>
            <input type="number" name="discountPrice" id="discountPrice" step="0.01" value="<%= product && product.discountPrice ? product.discountPrice : '' %>">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="category">Category</label>
            <select name="category" id="category" required>
              <option value="">Select Category</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat._id %>" <%= product && product.category && product.category.toString() === cat._id.toString() ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label for="stock">Stock</label>
            <input type="number" name="stock" id="stock" value="<%= product ? product.stock : 0 %>" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="unit">Unit</label>
            <input type="text" name="unit" id="unit" placeholder="e.g. 500g, 1L, 1 pc" value="<%= product ? product.unit : '1 pc' %>">
          </div>
          <div class="form-group">
            <label for="image">Product Image</label>
            <input type="file" name="image" id="image" accept="image/*">
            <% if (product && product.image) { %>
              <img src="<%= product.image %>" alt="" class="table-thumb" style="margin-top:8px">
            <% } %>
          </div>
        </div>

        <div class="form-group checkbox-group">
          <label>
            <input type="checkbox" name="isActive" <%= (!product || product.isActive) ? 'checked' : '' %>>
            Active (visible to customers)
          </label>
        </div>

        <button type="submit" class="btn btn-primary" id="saveProductBtn"><%= product ? 'Update Product' : 'Add Product' %></button>
      </form>
    </div>

    <a href="/admin/products" class="back-link">← Back to Products</a>
  </div>
</section>
