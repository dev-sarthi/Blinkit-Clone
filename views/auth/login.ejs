<div class="auth-page">
  <div class="auth-card">
    <h1>Welcome Back</h1>
    <p class="auth-subtitle">Log in to get your groceries fast</p>

    <form action="/auth/login" method="POST" class="auth-form" id="loginForm">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" name="email" id="email" placeholder="john@example.com" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" name="password" id="password" placeholder="Your password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full" id="loginSubmit">Log In</button>
    </form>

    <p class="auth-switch">Don't have an account? <a href="/auth/signup">Sign Up</a></p>
  </div>
</div>
