<section class="section">
  <div class="container">
    <h1 class="section-title">Order History</h1>

    <% if (orders.length === 0) { %>
      <div class="empty-state">
        <p>📦 No orders yet.</p>
        <a href="/products" class="btn btn-primary">Start Shopping</a>
      </div>
    <% } else { %>
      <div class="orders-list">
        <% orders.forEach(order => { %>
          <div class="order-card" id="order-<%= order._id %>">
            <div class="order-card-header">
              <div>
                <strong>Order #<%= order._id.toString().slice(-8).toUpperCase() %></strong>
                <span class="order-date"><%= order.createdAt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
              </div>
              <span class="status-badge status-<%= order.status %>"><%= order.status.replace(/_/g, ' ') %></span>
            </div>
            <div class="order-card-items">
              <% order.items.forEach(item => { %>
                <span class="order-item-brief"><%= item.name %> × <%= item.quantity %></span>
              <% }); %>
            </div>
            <div class="order-card-footer">
              <span class="order-total">₹<%= order.totalAmount %></span>
              <span class="order-payment"><%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Mock Online' %></span>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>
