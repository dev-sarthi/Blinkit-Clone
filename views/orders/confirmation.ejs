<section class="section">
  <div class="container">
    <div class="confirmation-card">
      <div class="confirmation-icon">🎉</div>
      <h1>Order Placed!</h1>
      <p class="delivery-estimate">⚡ Delivered in <strong>10–15 minutes</strong></p>

      <div class="order-id-box">
        <span>Order ID</span>
        <strong>#<%= order._id.toString().slice(-8).toUpperCase() %></strong>
      </div>

      <div class="confirmation-details">
        <h2>Items</h2>
        <% order.items.forEach(item => { %>
          <div class="checkout-item">
            <span><%= item.name %> × <%= item.quantity %></span>
            <span>₹<%= item.price * item.quantity %></span>
          </div>
        <% }); %>

        <div class="summary-row summary-total">
          <span>Total Paid</span>
          <span>₹<%= order.totalAmount %></span>
        </div>

        <h2>Delivery Address</h2>
        <p><%= order.address.fullAddress %>, <%= order.address.city %> — <%= order.address.pincode %></p>

        <h2>Payment</h2>
        <p><%= order.paymentMethod === 'cod' ? '💵 Cash on Delivery' : '💳 Mock Online Payment' %></p>
      </div>

      <div class="confirmation-actions">
        <a href="/orders/history" class="btn btn-secondary">View All Orders</a>
        <a href="/" class="btn btn-primary">Continue Shopping</a>
      </div>
    </div>
  </div>
</section>
