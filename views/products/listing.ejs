<section class="section">
  <div class="container">
    <div class="listing-header">
      <h1 class="section-title"><%= title %></h1>
      <span class="product-count"><%= products.length %> product<%= products.length !== 1 ? 's' : '' %></span>
    </div>

    <% if (products.length === 0) { %>
      <div class="empty-state">
        <p>🔍 No products found. Try a different search or category.</p>
        <a href="/products" class="btn btn-primary">Browse All</a>
      </div>
    <% } else { %>
      <div class="products-grid">
        <% products.forEach(product => { %>
          <div class="product-card" id="product-<%= product._id %>">
            <a href="/products/<%= product._id %>" class="product-image-link">
              <% if (product.image) { %>
                <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image" loading="lazy">
              <% } else { %>
                <div class="product-image product-image-placeholder">📦</div>
              <% } %>
            </a>
            <div class="product-info">
              <span class="product-unit"><%= product.unit %></span>
              <a href="/products/<%= product._id %>" class="product-name"><%= product.name %></a>
              <div class="product-pricing">
                <% if (product.discountPrice) { %>
                  <span class="price-current">₹<%= product.discountPrice %></span>
                  <span class="price-original">₹<%= product.price %></span>
                <% } else { %>
                  <span class="price-current">₹<%= product.price %></span>
                <% } %>
              </div>
              <% if (product.stock > 0) { %>
                <form action="/cart/add" method="POST" class="add-to-cart-form">
                  <input type="hidden" name="productId" value="<%= product._id %>">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="btn btn-add-cart">Add</button>
                </form>
              <% } else { %>
                <span class="out-of-stock-badge">Out of Stock</span>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="/products?<%= category ? 'category=' + category + '&' : '' %><%= search ? 'search=' + encodeURIComponent(search) + '&' : '' %>page=<%= i %>"
               class="page-link <%= i === currentPage ? 'active' : '' %>"
               id="page-<%= i %>">
              <%= i %>
            </a>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>
</section>
